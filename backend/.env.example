# Copy to .env and fill in. Never commit .env. (design §24.2 / §24.4)

# Core infra
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/podcast_synthesis
REDIS_URL=redis://localhost:6379/0

# Object storage. MVP supports a local-filesystem backend; swap to s3 in prod.
OBJECT_STORAGE_BACKEND=local            # local | s3
OBJECT_STORAGE_BUCKET=podcast-synthesis
OBJECT_STORAGE_REGION=us-east-1
LOCAL_STORAGE_ROOT=./.storage
SIGNED_URL_EXPIRY_SECONDS=3600

# Provider adapters (later milestones; unset is fine for M1)
LLM_PROVIDER=fake                       # fake | openai | anthropic
LLM_API_KEY=
TTS_PROVIDER=fake                       # fake | elevenlabs | ...
TTS_API_KEY=

# Vector store (M2)
VECTOR_DB_URL=

# Auth (dev stub — replace before beta)
JWT_SECRET=dev-insecure-change-me
DEV_BEARER_TOKEN=dev-token

# Job queue backend: inproc (default, no redis) | rq
JOB_QUEUE_BACKEND=inproc

ENV=local
