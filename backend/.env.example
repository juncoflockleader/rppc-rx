# Copy to .env and fill in. Never commit .env. (design §24.2 / §24.4)

# Core infra
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/podcast_synthesis
REDIS_URL=redis://localhost:6379/0

# Object storage. MVP supports a local-filesystem backend; swap to s3 in prod.
OBJECT_STORAGE_BACKEND=local            # local | s3
OBJECT_STORAGE_BUCKET=podcast-synthesis
OBJECT_STORAGE_REGION=us-east-1
LOCAL_STORAGE_ROOT=./.storage
SIGNED_URL_EXPIRY_SECONDS=3600

# LLM provider (design §13). Tests/dev default to the deterministic fake.
LLM_PROVIDER=fake                       # fake | anthropic | openai
LLM_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=claude-opus-4-8               # used when LLM_PROVIDER=anthropic
OPENAI_LLM_MODEL=gpt-4o                 # used when LLM_PROVIDER=openai

# Embedding provider. Anthropic has no first-party embeddings (use Voyage; out of scope).
EMBEDDING_PROVIDER=fake                 # fake | openai
EMBEDDING_MODEL=text-embedding-3-small
FAKE_EMBEDDING_DIM=64

# TTS provider (M7)
TTS_PROVIDER=fake                       # fake | elevenlabs | ...
TTS_API_KEY=

# Chunking (design §11.1, §27)
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# External vector store (unused — MVP keeps vectors in Postgres/pgvector)
VECTOR_DB_URL=

# Auth (dev stub — replace before beta)
JWT_SECRET=dev-insecure-change-me
DEV_BEARER_TOKEN=dev-token

# Job queue backend: inproc (default, no redis) | rq
JOB_QUEUE_BACKEND=inproc

ENV=local
